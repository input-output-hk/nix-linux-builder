#!/usr/bin/env bash
# nix-linux-shell — Interactive Linux build environment via nix-linux-builder
# Copyright 2025 Moritz Angermann <moritz.angermann@iohk.io>, Input Output Group
# Apache License 2.0
#
# Provides nix-shell-like debugging for Linux builds on macOS:
#   nix-linux-shell                      → bare shell with /nix/store
#   nix-linux-shell <.drv>               → build environment from derivation
#   nix-linux-shell --debug <.drv>       → run build, drop to shell on failure
#   nix-linux-shell <flake-ref>          → resolve flake ref to .drv, then shell
#
# Paths substituted by the darwin module at install time:
KERNEL="@kernel@"
INITRD="@initrd@"
BUILDER="@builder@"

set -euo pipefail

usage() {
    cat >&2 <<EOF
Usage: nix-linux-shell [--debug] [<.drv path or flake ref>]

Interactive Linux build environment via nix-linux-builder.

Modes:
  (no argument)          Bare shell with /nix/store mounted
  <.drv>                 Shell with derivation's build environment
  --debug <.drv>         Run the build, drop to shell on failure
  <flake-ref>            Resolve to .drv first, then shell

Options:
  --debug                Enable debug mode (run build, shell on failure)
  -h, --help             Show this help
EOF
    exit "${1:-1}"
}

DEBUG_FLAG=""
DRV_ARG=""

# Parse arguments
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)   usage 0 ;;
        --debug)     DEBUG_FLAG="--debug"; shift ;;
        -*)          echo "Unknown option: $1" >&2; usage 1 ;;
        *)
            if [ -n "$DRV_ARG" ]; then
                echo "Unexpected extra argument: $1" >&2
                usage 1
            fi
            DRV_ARG="$1"
            shift
            ;;
    esac
done

# Validate substituted paths exist
for var_name in KERNEL INITRD BUILDER; do
    val="${!var_name}"
    if [[ "$val" == @*@ ]]; then
        echo "error: $var_name not substituted — is nix-linux-shell installed via the darwin module?" >&2
        exit 1
    fi
    if [ ! -r "$val" ]; then
        echo "error: $var_name path not found: $val" >&2
        exit 1
    fi
done

# ── Bare shell mode (no derivation) ─────────────────────────────────────
if [ -z "$DRV_ARG" ]; then
    if [ -n "$DEBUG_FLAG" ]; then
        echo "error: --debug requires a derivation argument" >&2
        usage 1
    fi
    exec sudo "$BUILDER" --shell --kernel "$KERNEL" --initrd "$INITRD" --network
fi

# ── Resolve flake ref to .drv if needed ──────────────────────────────────
DRV_PATH="$DRV_ARG"
if [[ "$DRV_PATH" != *.drv ]]; then
    echo "Resolving flake ref to derivation..." >&2
    DRV_PATH="$(nix path-info --derivation "$DRV_ARG" 2>/dev/null)" || {
        echo "error: failed to resolve '$DRV_ARG' to a derivation" >&2
        exit 1
    }
fi

# Validate the .drv exists in the store
if [ ! -r "$DRV_PATH" ]; then
    echo "error: derivation not found: $DRV_PATH" >&2
    exit 1
fi

# ── Build all dependencies ───────────────────────────────────────────────
echo "Building derivation dependencies..." >&2
nix build "${DRV_PATH}^*" --no-link 2>&1 | tail -1 || true

# ── Synthesize build.json from the derivation ────────────────────────────
TMPDIR_ROOT="$(mktemp -d /tmp/nix-linux-shell.XXXXXX)"
trap 'rm -rf "$TMPDIR_ROOT"' EXIT

# Create the build/ subdirectory (guest init expects it)
mkdir -p "$TMPDIR_ROOT/build"

# Get the structured derivation JSON (nix 2.34+ format).
# Format: { "derivations": { "<short-hash>.drv": { ... } }, "version": 4 }
# Keys in .derivations are basenames (no /nix/store/ prefix).
DRV_JSON="$(nix derivation show "$DRV_PATH" 2>&1)" || {
    echo "error: failed to read derivation: $DRV_JSON" >&2
    exit 1
}

# Extract the derivation key (basename of the .drv path) and validate
# that the JSON actually contains this derivation.
DRV_KEY="$(basename "$DRV_PATH")"
if ! echo "$DRV_JSON" | jq -e --arg key "$DRV_KEY" '.derivations[$key]' >/dev/null 2>&1; then
    echo "error: derivation '$DRV_KEY' not found in 'nix derivation show' output" >&2
    exit 1
fi

# Resolve all input derivation outputs to their full store paths.
# nix 2.34 format:
#   inputs.drvs: { "<short-hash>.drv": { "outputs": ["out", ...] } }
#   inputs.srcs: ["<short-hash>-name", ...]
# All names need /nix/store/ prepended to become full paths.
resolve_input_paths() {
    local drv_json="$1"
    local drv_key="$2"

    # Collect inputs.srcs — these are already realized store objects,
    # just need /nix/store/ prefix added.
    local input_srcs
    input_srcs="$(echo "$drv_json" | jq -r --arg key "$drv_key" \
        '.derivations[$key].inputs.srcs // [] | .[] | "/nix/store/" + .')"

    # Collect inputs.drvs — for each input drv, query its realized
    # output paths. We include all outputs (not just the specifically
    # requested ones) because nix-store --query --outputs is fast and
    # local, whereas per-output nix derivation show would be very slow
    # for derivations with many inputs. Extra paths are harmless since
    # /nix/store is fully mounted in the guest.
    local input_drv_paths=""
    while IFS= read -r dep_drv_name; do
        [ -z "$dep_drv_name" ] && continue
        local dep_drv_full="/nix/store/$dep_drv_name"
        local out_paths
        out_paths="$(nix-store --query --outputs "$dep_drv_full" 2>/dev/null)" || true
        if [ -n "$out_paths" ]; then
            input_drv_paths="$input_drv_paths"$'\n'"$out_paths"
        fi
    done < <(echo "$drv_json" | jq -r --arg key "$drv_key" \
        '.derivations[$key].inputs.drvs // {} | keys[]')

    # Combine and deduplicate
    printf '%s\n%s' "$input_srcs" "$input_drv_paths" | sort -u | grep -v '^$' || true
}

INPUT_PATHS="$(resolve_input_paths "$DRV_JSON" "$DRV_KEY")"

# Build the build.json using jq.
# nix 2.34 output paths are short hashes — prepend /nix/store/.
echo "$DRV_JSON" | jq --arg key "$DRV_KEY" \
    --arg topTmpDir "$TMPDIR_ROOT" \
    --arg tmpDir "$TMPDIR_ROOT/build" \
    --argjson inputPaths "$(echo "$INPUT_PATHS" | jq -R -s 'split("\n") | map(select(length > 0))')" \
    '{
        version: 1,
        system: .derivations[$key].system,
        builder: .derivations[$key].builder,
        args: .derivations[$key].args,
        env: (.derivations[$key].env // {}),
        inputPaths: $inputPaths,
        outputs: (
            (.derivations[$key].outputs // {})
            | to_entries
            | map({(.key): ("/nix/store/" + .value.path)})
            | add // {}
        ),
        topTmpDir: $topTmpDir,
        tmpDir: $tmpDir,
        tmpDirInSandbox: "/build",
        storeDir: "/nix/store",
        realStoreDir: "/nix/store"
    }' > "$TMPDIR_ROOT/build.json"

echo "Build environment ready. Launching VM..." >&2

# ── Launch the builder ───────────────────────────────────────────────────
# shellcheck disable=SC2086
exec sudo "$BUILDER" --shell $DEBUG_FLAG \
    --kernel "$KERNEL" --initrd "$INITRD" --network \
    "$TMPDIR_ROOT/build.json"
